# Matches docker-compose.yml. Copy to .env for sqlx compile-time checks and `sqlx` CLI;
# the binary reads DATABASE_URL from the process environment only.
DATABASE_URL=postgres://factory:factory@127.0.0.1:5432/factory

# Reconciler / AWS (the binary reads these from the process environment).
# AWS credentials and region come from the standard AWS env/profile chain. The orchestrator's
# IAM identity needs: ec2:RunInstances, ec2:CreateTags (instance + volume, at launch),
# ec2:TerminateInstances, ec2:DescribeInstances, ec2:DescribeSecurityGroups,
# ssm:DescribeInstanceInformation, ssm:SendCommand (on the AWS-RunShellScript document and the instances), and
# iam:PassRole for the instance profile's role.
FACTORY_DEPLOYMENT_ID=dev                     # tag value scoping list/cleanup; unique per deployment per account+region
FACTORY_AMI_ID=ami-xxxxxxxxxxxxxxxxx          # needs the SSM agent and cloud-init (e.g. Amazon Linux 2023)
FACTORY_SUBNET_ID=subnet-xxxxxxxx             # needs outbound HTTPS to SSM (NAT, public IP, or VPC endpoints)
FACTORY_SECURITY_GROUP_ID=sg-xxxxxxxx         # must have ZERO inbound rules; startup refuses otherwise
FACTORY_INSTANCE_PROFILE=factory-vm           # role with AmazonSSMManagedInstanceCore
FACTORY_PUBLIC_URL=https://factory.example.com # how VMs reach the agent API; use https (tokens are bearer secrets)
# FACTORY_LISTEN_ADDR=127.0.0.1:8080          # put a TLS-terminating proxy in front
# FACTORY_INSTANCE_TYPE=t3.micro
# FACTORY_RECONCILE_INTERVAL_SECS=5
# FACTORY_HEARTBEAT_TIMEOUT_SECS=300
# FACTORY_MAX_LAUNCHES_PER_TICK=5
# FACTORY_MAX_ACTIVE_TASKS_PER_TENANT=5    # also bounds each tenant's share of the model API
# FACTORY_TICK_TIMEOUT_SECS=120
# RUST_LOG=info

# Required even for hello-only tasks. Customer-managed KMS key in AWS_REGION.
AWS_REGION=us-east-1
FACTORY_SECRETS_KMS_KEY_ARN=arn:aws:kms:us-east-1:123456789012:key/00000000-0000-0000-0000-000000000000
# Optional GitHub App mode: set BOTH, then configure repository_credentials (README).
# FACTORY_GITHUB_APP_ID=123456
# FACTORY_GITHUB_PRIVATE_KEY_PARAMETER=/factory/dev/control/github-private-key
# Source secrets are SecureStrings; VM IAM isolation requires docs/vm-secret-policy.json.
