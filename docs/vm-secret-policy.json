{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyParametersOwnedByOtherInstances",
      "Effect": "Deny",
      "Action": ["ssm:GetParameter", "ssm:GetParameters"],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "ssm:resourceTag/factory:instance-arn": "${ec2:SourceInstanceARN}"
        }
      }
    },
    {
      "Sid": "DenyWhenNotUsingInstanceCredentials",
      "Effect": "Deny",
      "Action": ["ssm:GetParameter", "ssm:GetParameters"],
      "Resource": "*",
      "Condition": {"Null": {"ec2:SourceInstanceARN": "true"}}
    },
    {
      "Sid": "DenyHistoryAndPathReads",
      "Effect": "Deny",
      "Action": ["ssm:GetParameterHistory", "ssm:GetParametersByPath"],
      "Resource": "*"
    },
    {
      "Sid": "ReadOwnTaskBundle",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/factory/DEPLOYMENT/tasks/*",
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/factory:instance-arn": "${ec2:SourceInstanceARN}"
        }
      }
    },
    {
      "Sid": "DecryptTaskBundleThroughParameterStore",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:REGION:ACCOUNT_ID:key/KMS_KEY_ID",
      "Condition": {
        "StringEquals": {"kms:ViaService": "ssm.REGION.amazonaws.com"},
        "StringLike": {
          "kms:EncryptionContext:PARAMETER_ARN": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/factory/DEPLOYMENT/tasks/*"
        }
      }
    }
  ]
}
